# Copy this file to .env (same folder as server.py). All optional: without it NCI runs on its built-in rules.
# Open the NCI > Orchestration tab to see which of these are set (values are never shown).

# --- NCI chat assistant + tracking of new messages (direct OpenAI call, no extra packages) ---
# Without a key NCI answers with its rule engine. Answers are checked against the sources before they are shown.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   (any OpenAI-compatible endpoint)
# NCI_CHAT_LLM=0          turn the LLM off without removing the key
# NCI_CAPTURE_CHATS=0     do not track 1:1 and group chats (channels are still tracked)

# --- GAIK curator and summaries (LLM) ---
# Provider: azure (GAIK default) | openai | anthropic | google | aitta
NCI_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# NCI_MODEL=
# LLM summary on answers is on whenever a provider key works (checked against the facts; dropped if it invents anything). Set 0 to turn off
# NCI_LLM_SUMMARY=0

# --- Semantic search (Anthropic has no embeddings API, so pick another provider) ---
# NCI_EMBED_PROVIDER=openai
# OPENAI_API_KEY=

# --- Cost control ---
# NCI_DAILY_TOKEN_BUDGET=200000
# NCI_BREAKER_SECONDS=300

# --- Who may see what ---
# assertions (default): people outside a channel see role-labelled conclusions, no quotes or names | members | off
# NCI_ORG_VISIBILITY=assertions
NCI_CAPTURE_CHANNELS=General,Transport,Maintenance
# Review periods in days, per kind of knowledge:
# NCI_TTL_DAYS_WORKAROUND=180

# --- Real Microsoft Teams (see README) ---
# TEAMS_WEBHOOK_SECRET=
# GRAPH_CLIENT_STATE=
# GRAPH_TOKEN=
# NCI_DEFAULT_CHANNEL=Transport
